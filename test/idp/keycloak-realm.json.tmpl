{
  "realm": "pandokos",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "groups": [
    {"name": "pandokos-admins"},
    {"name": "tenant-a-admins"}
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "groups": ["pandokos-admins", "tenant-a-admins"],
      "credentials": [{"type": "password", "value": "@ALICE_PASSWORD@", "temporary": false}]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Nobody",
      "credentials": [{"type": "password", "value": "@BOB_PASSWORD@", "temporary": false}]
    }
  ],
