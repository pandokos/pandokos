{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tenant deleted",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable identifier of the event; the receiver's idempotency key."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The events.source of the installation."
    },
    "type": {
      "const": "io.pandokos.tenant.deleted.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact was recorded, UTC, microseconds."
    },
    "subject": {
      "type": "string",
      "description": "The tenant ID."
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "tenantid": {
      "type": "string",
      "format": "uuid",
      "description": "The tenant the event belongs to."
    },
    "tenantref": {
      "type": "string",
      "minLength": 1,
      "description": "The tenant's external reference, when it has one."
    },
    "sequence": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Position in the log, a string of digits."
    },
    "data": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "external_reference": {
          "type": "string",
          "description": "The tenant's external reference, when it has one."
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "kek_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completion_seq": {
          "type": "integer",
          "minimum": 1,
          "description": "The completion record in the platform's audit chain."
        }
      },
      "required": [
        "tenant_id",
        "requested_at",
        "completed_at",
        "kek_versions",
        "completion_seq"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "subject",
    "datacontenttype",
    "tenantid",
    "sequence",
    "data"
  ],
  "additionalProperties": true
}
