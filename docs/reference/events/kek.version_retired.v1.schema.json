{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Key version retired",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable identifier of the event; the receiver's idempotency key."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The events.source of the installation."
    },
    "type": {
      "const": "io.pandokos.kek.version_retired.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact was recorded, UTC, microseconds."
    },
    "subject": {
      "type": "string",
      "description": "The key version."
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Position in the log, a string of digits."
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "provider"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "subject",
    "datacontenttype",
    "sequence",
    "data"
  ],
  "additionalProperties": true
}
