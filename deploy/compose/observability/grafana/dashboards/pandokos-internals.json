            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pandokos_authn_reason) (rate(pandokos_authn_attempts_total{pandokos_authn_result!=\"ok\", pandokos_authn_reason!=\"\"}[$__rate_interval])) or on() vector(0)",
          "legendFormat": "{{pandokos_authn_reason}}",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Sign-in attempts",
      "description": "Sign-ins by method (password, OIDC) and result (M21).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
