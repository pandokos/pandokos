            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pandokos_password_state) (pandokos_password_hashes) or on() vector(0)",
          "legendFormat": "{{pandokos_password_state}}",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Idempotent replays, refused grants and support actions",
      "description": "Requests answered from a stored response (M25), grants the authorization refused (M26), support actions opened and ended (M27, M28).",
