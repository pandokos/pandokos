          },
          "expr": "sum(rate(pandokos_idempotency_replays_total[$__rate_interval])) or on() vector(0)",
          "legendFormat": "idempotent replays",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pandokos_authz_grants_refused_total[$__rate_interval])) or on() vector(0)",
          "legendFormat": "grants refused",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pandokos_support_actions_opened_total[$__rate_interval])) or on() vector(0)",
          "legendFormat": "support actions opened",
          "editorMode": "code",
          "range": true
