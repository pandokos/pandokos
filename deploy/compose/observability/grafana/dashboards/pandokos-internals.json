        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pandokos_support_cause) (rate(pandokos_support_actions_ended_total[$__rate_interval])) or on() vector(0)",
          "legendFormat": "support actions ended {{pandokos_support_cause}}",
          "editorMode": "code",
          "range": true
        }
